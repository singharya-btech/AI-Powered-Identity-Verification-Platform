# ==============================================================================
# Stage 1: Build the React Application (Node.js & Vite)
# ==============================================================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency specifications first to leverage Docker layer caching
COPY frontend-react/package*.json ./
RUN npm ci

# Copy frontend source code and configuration
COPY frontend-react/ ./

# Ensure relative API calls proxy through Nginx in production
ENV VITE_API_BASE_URL=""

# Build optimized production bundle
RUN npm run build

# ==============================================================================
# Stage 2: Production Nginx Server & API Reverse Proxy
# ==============================================================================
FROM nginx:1.27-alpine-slim

# Copy custom Nginx configuration
COPY frontend-react/nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose HTTP port
EXPOSE 80

# Container healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:80/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
