# ==============================================================================
# AI-Powered E-KYC Identity Verification Platform - Environment Template (.env)
#
# NOTE: 100% Local AI Execution (EasyOCR + DeepFace FaceNet).
# ZERO external cloud APIs, ZERO third-party API keys required for inference or training.
# All computer vision, biometric comparison, and KYC logic runs on your local machine.
# ==============================================================================

# Application Metadata & Runtime Environment
APP_NAME="E-KYC Verification Platform"
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=false
API_V1_STR=/api/v1
ENABLE_DOCS=true

# Platform Administrator Credentials (Auto-provisioned and synced on backend boot)
ADMIN_EMAIL=admin@ekyc-platform.com
ADMIN_PASSWORD=Admin@Secure2026!
ADMIN_FULL_NAME=System Administrator

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ekyc_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ekyc_db

# Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=1800

# Security & JWT Authentication
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Networking & Ingress Ports
FRONTEND_PORT=80
CORS_ORIGINS=["http://localhost", "http://localhost:80", "http://localhost:5173", "http://127.0.0.1:5173"]

# Local AI Models & Cache Paths
DEEPFACE_HOME=/app/data
EASYOCR_MODULE_PATH=/home/appuser/.EasyOCR
