# ==============================================================================
# Production Dockerfile for AI-Powered E-KYC Backend
# Python 3.11-slim + OpenCV + DeepFace + EasyOCR + PostgreSQL runtime
# ==============================================================================
FROM python:3.11-slim

# Prevent Python from writing .pyc files and enable unbuffered logging
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEEPFACE_HOME=/app/data \
    EASYOCR_MODULE_PATH=/home/appuser/.EasyOCR \
    PYTHONPATH=/app

# Install system dependencies required for OpenCV, PyTorch, and PostgreSQL
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    curl \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Create non-root unprivileged security user (appuser, UID 10001)
RUN groupadd --gid 10001 appgroup \
    && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/appuser --shell /bin/bash appuser

WORKDIR /app

# Install Python backend dependencies first to leverage Docker layer caching
COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application source code and Alembic migrations
COPY backend ./backend
COPY alembic.ini ./alembic.ini

# Copy pre-cached local AI model weights (FaceNet and Haar Cascade)
COPY data/models ./data/models
COPY data/.deepface ./data/.deepface

# Create required directories and ensure correct ownership for non-root execution
RUN mkdir -p /app/data/temp_faces /app/logs /home/appuser/.EasyOCR \
    && chown -R appuser:appgroup /app /home/appuser

# Switch to unprivileged user
USER appuser:appgroup

# Expose FastAPI application port
EXPOSE 8000

# Healthcheck checking the active API health status endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://127.0.0.1:8000/api/v1/health || exit 1

# Default command runs Uvicorn ASGI server
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
