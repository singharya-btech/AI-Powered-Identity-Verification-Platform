# ==============================================================================
# AI-Powered E-KYC Identity Verification Platform - PRODUCTION Environment (.env)
#
# INSTRUCTIONS FOR PRODUCTION SERVER DEPLOYMENT:
# 1. Copy this template to .env on your production server:
#    cp .env.production.example .env
# 2. Generate strong, cryptographically secure random passwords and secrets.
#    Generate random secret key: openssl rand -hex 32
# 3. Replace all default passwords (POSTGRES_PASSWORD, ADMIN_PASSWORD, JWT_SECRET_KEY).
# 4. Set CORS_ORIGINS to your actual production domain(s) or server IP.
# 5. ZERO external cloud APIs or API keys are required (100% offline local AI).
# ==============================================================================

# Application Metadata & Runtime Environment
APP_NAME="E-KYC Verification Platform"
APP_ENV=production
APP_VERSION=1.0.0
DEBUG=false
API_V1_STR=/api/v1
# Set ENABLE_DOCS to false in production to disable public Swagger UI (/docs)
ENABLE_DOCS=false

# Platform Administrator Credentials (Auto-provisioned and synced on boot)
ADMIN_EMAIL=admin@yourdomain.com
# Use a strong password with at least 12 characters, uppercase, lowercase, numbers, and symbols
ADMIN_PASSWORD=ChangeMeInProduction#2026!
ADMIN_FULL_NAME=Platform Administrator

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
# Generate a strong database password: openssl rand -base64 16
POSTGRES_PASSWORD=StrongDbPassword2026!
POSTGRES_DB=ekyc_db
POSTGRES_PORT=5432
# When deploying with Docker Compose, the database service hostname is 'db'
DATABASE_URL=postgresql://postgres:StrongDbPassword2026!@db:5432/ekyc_db

# Connection Pool Tuning (Tuned for production concurrent workloads)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=1800

# Security & JWT Authentication
# GENERATE A REAL SECRET KEY: openssl rand -hex 32
JWT_SECRET_KEY=generate-a-secure-random-secret-key-at-least-32-bytes-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Networking & CORS Configuration
# Replace with your actual server IP or domain (e.g. https://ekyc.example.com)
FRONTEND_PORT=80
CORS_ORIGINS=["https://ekyc.yourdomain.com", "http://your-server-ip"]

# Local AI Models & Cache Paths (Docker volume paths)
DEEPFACE_HOME=/app/data
EASYOCR_MODULE_PATH=/home/appuser/.EasyOCR

